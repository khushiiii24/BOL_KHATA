# ===== Bol Khata settings =====
# Only the first line is needed. Paste your key from app.gnani.ai after the = sign.
GNANI_API_KEY=paste-your-gnani-key-here

# Your shop's name for reminder messages while sign-in is off.
# (With sign-in on, each person types their own shop name after signing up.)
SHOP_NAME=Sharma General Store

# ----- Recommended: Gmail login / sign-up (GOOGLE_LOGIN_SETUP.md) -----
# Paste the Client ID from Google Cloud. Then every Gmail that signs in gets its OWN private khata.
# Leave it empty to keep sign-in off (one shared khata on this laptop).
GOOGLE_CLIENT_ID=
# Who may sign up? Empty = anyone with a Google account (and, while your Google app is in
# "Testing", only its test users). Or list Gmails, comma-separated, to invite only them:
# ALLOWED_EMAILS=me@gmail.com,brother@gmail.com
ALLOWED_EMAILS=

# ----- Optional: smarter understanding (free) -----
# Without this, Bol Khata uses its built-in rules, which work for common sentences.
# With a free Groq key (console.groq.com -> API Keys) it understands almost anything.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# To use Google Gemini instead (key from aistudio.google.com):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# ----- Optional: Gnani model and voice choices -----
# STT_MODEL=prisma-v3.0
# TTS_MODEL=timbre-v2.5
# One voice per language (these are the defaults):
# TTS_VOICE_HI=Nalini
# TTS_VOICE_EN=Kaveri
# TTS_VOICE_MR=Zahira
# TTS_VOICE_GU=Falak
# TTS_VOICE_BN=Kirra
# TTS_VOICE_TA=Asmita
# TTS_VOICE_TE=Lavanya
# TTS_VOICE_KN=Saanvi

# ----- Only if you put Bol Khata online (not needed on your laptop) -----
# PUBLIC_URL=https://bolkhata.example.com

# Only when online (for example on Vercel): any long random text, so sign-in keeps working.
# SESSION_SECRET=
# DATA_DIR=
